{
  "info": {
    "name": "Tienda - API Gateway (DSY1104)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"admin\",\n  \"password\": \"admin12345\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login cliente",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"cliente\",\n  \"password\": \"cliente12345\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenCliente', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Listar productos (publico)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Ver pedidos sin token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Cliente crea producto",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenCliente}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"X\",\n  \"precio\": 1,\n  \"stock\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Admin crea producto",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Monitor\",\n  \"precio\": 150000,\n  \"stock\": 5\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Cliente crea pedido",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenCliente}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Cliente ve sus pedidos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenCliente}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Admin ve todos los pedidos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}